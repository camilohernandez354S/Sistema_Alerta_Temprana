# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN (RENDER)
# ===========================================
SERVER_IP=192.168.137.24
SERVER_PORT=5000
FRONTEND_PORT=8080
WIFI_SSID=nombre_de_tu_red_wifi
WIFI_PASSWORD=tu_contraseña_wifi
FLASK_SERVER_URL=http://192.168.137.24:5000
# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_SECRET_KEY_IN_RENDER

# MongoDB Configuration (Render Database)
MONGO_URI=mongodb://mongo:27017/
MONGO_DB=sat_database

# CORS Configuration
CORS_ORIGINS=https://sat-frontend.onrender.com,https://your-domain.com

# Arduino Configuration (Deshabilitado en producción)
ARDUINO_ENABLED=False

# Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_production_email@gmail.com
MAIL_PASSWORD=your_production_app_password

# Redis Configuration (Render Redis)
REDIS_URL=redis://sat-redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=/tmp/app.log

# Security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
