# Configuración de la aplicación
FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
SECRET_KEY=dev-secret-key-change-in-production

# Configuración de MongoDB
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=sensor_database
MONGO_COLLECTION=sensor_readings

# Para testing
MONGO_DB_TEST=sensor_database_test

# Configuración de CORS
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Configuración de logging
LOG_LEVEL=INFO
LOG_FILE=app.log

# Configuración de Arduino (para leer_serial.py)
SERIAL_PORT=COM3
BAUD_RATE=9600

# Configuración de JWT
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# Configuración de Redis (para rate limiting)
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true

# Configuración de Email (para notificaciones y recuperación de contraseñas)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-password-de-aplicacion
MAIL_DEFAULT_SENDER=tu-email@gmail.com
MAIL_FROM_NAME=Sistema de Monitoreo

# Configuración del Frontend
FRONTEND_URL=http://localhost:8080

# Configuración de seguridad (opcional)
REQUIRE_API_KEY=false
API_KEY=your-api-key-here
